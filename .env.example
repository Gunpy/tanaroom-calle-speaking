# CALL-E
SPEAKING_ENABLED=true
SPEAKING_PROVIDER=calle
CALLE_API_KEY=
CALLE_API_BASE_URL=https://api.heycall-e.com
CALLE_REQUEST_TIMEOUT_MS=30000
CALLE_WEBHOOK_TOKEN=
CALLE_WEBHOOK_PUBLIC_URL=https://<your-host>/speaking/webhook/<token>

# Call rules
SPEAKING_MAX_CALL_MINUTES=5
SPEAKING_MIN_CHARGE_SECONDS=60
SPEAKING_MIN_USER_TURNS=2
SPEAKING_MIN_ANALYSIS_USER_TURNS=2

# Watchdog and live refresh
SPEAKING_CALL_TIMEOUT_SECONDS=900
SPEAKING_WEBHOOK_GRACE_SECONDS=120
SPEAKING_SCHEDULER_ENABLED=true
SPEAKING_LIVE_REFRESH_SECONDS=15
